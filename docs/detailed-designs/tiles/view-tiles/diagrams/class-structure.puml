@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View tiles

class Tile {
  +Guid Id
  +Guid OwnerId
  +string Name
  +string Url
  +string? Description
  +string Color
  +string Initial
  +string? Category
  +int SortOrder
  +TileSize Size
  +DateTimeOffset? LastOpenedAt
  +DateTimeOffset CreatedAt
}
enum TileSize {
  Large
  Small
}
Tile --> TileSize : has
class GetTilesQuery <<record>>
class GetTileQuery <<record>> {
  +Guid Id
}
class GetTilesQueryHandler {
  +Handle(q: GetTilesQuery): Task<IReadOnlyList<TileDto>>
}
class GetTileQueryHandler {
  +Handle(q: GetTileQuery): Task<TileDto>
}
class NotFoundException
class TileDto <<record>>
interface IAppDbContext
interface ICurrentUser
GetTilesQueryHandler ..> GetTilesQuery : handles
GetTileQueryHandler ..> GetTileQuery : handles
GetTilesQueryHandler --> IAppDbContext
GetTileQueryHandler --> IAppDbContext
GetTilesQueryHandler --> ICurrentUser
GetTileQueryHandler --> ICurrentUser
GetTileQueryHandler ..> NotFoundException : throws
GetTilesQueryHandler ..> TileDto : returns
GetTileQueryHandler ..> TileDto : returns
TileDto ..> Tile : projects
@enduml
