@startuml
title UML sequence behaviour — Get one tile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard owner" as actor
box "Frontend — ingresso web app" #E0F2FE
  participant "HttpTilesApi" as client
end box
box "Backend — Ingresso.Api" #D1FADF
  participant "TilesController" as controller
end box
box "Backend — Ingresso.Application and Domain" #ECFDF3
  participant "GetTileQueryHandler" as handler
end box
box "Backend — Ingresso.Infrastructure" #FFF4E5
  database "ingresso database" as db
end box
actor -> client : get(id)
client -> controller : GET /api/tiles/{id}
controller -> handler : Send GetTileQuery(id)
handler -> db : SELECT WHERE Id = id AND OwnerId = current
alt row found
  db --> handler : tile
  handler --> controller : TileDto
  controller --> client : 200 OK
else no row (L2-005, L2-032)
  db --> handler : none
  handler --> controller : NotFoundException
  controller --> client : 404 ProblemDetails
end
@enduml
