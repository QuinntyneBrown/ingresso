@startuml
title UML sequence behaviour — Validate a session on each request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as actor
box "Frontend — ingresso web app" #E0F2FE
  participant "HttpTilesApi" as client
end box
box "Backend — Ingresso.Api" #D1FADF
  participant "Cookie authentication" as cookie
  participant "SessionValidator" as validator
end box
box "Backend — Ingresso.Application and Domain" #ECFDF3
  participant "TouchSessionCommandHandler" as handler
end box
box "Backend — Ingresso.Infrastructure" #FFF4E5
  database "ingresso database" as db
end box
actor -> client : Any API call
client -> cookie : Request with session cookie
cookie -> validator : ValidateAsync(principal)
validator -> handler : Send TouchSessionCommand(sid)
handler -> db : SELECT Session by Id
alt unknown, revoked, idle > 14 days, or age > 30 days (L2-030)
  handler --> validator : false
  validator -> cookie : RejectPrincipal, SignOut cookie
  cookie --> client : 401 ProblemDetails
else active
  handler -> db : LastSeenAtUtc = now (slide idle window)
  handler --> validator : true
  cookie --> client : Request proceeds
end
@enduml
