@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Harden responses

class SecurityHeadersMiddleware {
  +InvokeAsync(http): Task
}
class RequestLoggingMiddleware {
  +CorrelationHeader = X-Correlation-Id
  +InvokeAsync(http): Task
}
class AppTile <<ig-app-tile>> {
  +name: string
  +href: string
}
class DomSanitizer <<Angular>>
AppTile ..> DomSanitizer : default URL sanitization
@enduml
