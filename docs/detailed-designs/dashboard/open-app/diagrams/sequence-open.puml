@startuml
title UML sequence behaviour — Open an app and record it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard owner" as actor
box "Frontend — ingresso web app" #E0F2FE
  participant "ig-app-tile" as tile
  participant "TilesStore" as store
  participant "HttpTilesApi" as client
end box
box "Backend — Ingresso.Api" #D1FADF
  participant "TilesController" as controller
end box
box "Backend — Ingresso.Application and Domain" #ECFDF3
  participant "MarkTileOpenedCommandHandler" as handler
end box
box "Backend — Ingresso.Infrastructure" #FFF4E5
  database "ingresso database" as db
end box
actor -> tile : Click or press Enter
alt edit mode
  tile --> actor : No navigation (L2-012)
else normal mode
  tile -> tile : Navigate target=_blank rel=noopener noreferrer (L2-012)
  tile -> store : opened
  store -> client : markOpened(id)
  client -> controller : POST /api/tiles/{id}/opened
  controller -> handler : Send MarkTileOpenedCommand
  handler -> db : SELECT WHERE Id = id AND OwnerId = current
  alt not found (another user's tile)
    handler --> controller : NotFoundException
    controller --> client : 404 ProblemDetails
    client --> store : error ignored (L2-013)
  else found
    handler -> handler : LastOpenedAt = IClock.UtcNow (L2-013)
    handler -> db : UPDATE
    handler --> controller : TileDto
    controller --> client : 200 OK
    client --> store : Tile
    store --> tile : openedLabel = Opened just now (L2-014)
  end
end
@enduml
