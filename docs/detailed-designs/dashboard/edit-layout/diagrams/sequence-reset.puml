@startuml
title UML sequence behaviour — Reset the layout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard owner" as actor
box "Frontend — ingresso web app" #E0F2FE
  participant "ig-layout-bar" as bar
  participant "Reset layout dialog" as confirm
  participant "TilesStore" as store
  participant "HttpTilesApi" as client
end box
box "Backend — Ingresso.Api" #D1FADF
  participant "TilesController" as controller
end box
box "Backend — Ingresso.Application and Domain" #ECFDF3
  participant "ResetLayoutCommandHandler" as handler
end box
box "Backend — Ingresso.Infrastructure" #FFF4E5
  database "ingresso database" as db
end box
actor -> bar : Reset layout
bar -> confirm : open (L2-019)
alt Keep my layout
  confirm --> actor : Layout unchanged
else Reset layout
  confirm -> store : resetLayout()
  store -> client : resetLayout()
  client -> controller : POST /api/tiles/reset-layout
  controller -> handler : Send ResetLayoutCommand
  handler -> db : SELECT owner tiles
  handler -> handler : Order by CreatedAt, Name; place 3x2, four per row
  handler -> db : UPDATE in one unit of work
  controller --> client : 200 OK TileDto[]
  client --> store : Tile[]
  store --> actor : Default layout, success toast
end
@enduml
