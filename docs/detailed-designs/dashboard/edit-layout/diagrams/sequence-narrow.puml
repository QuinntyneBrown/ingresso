@startuml
title UML sequence behaviour — Edit mode on a narrow window
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard owner" as actor
box "Frontend — ingresso web app" #E0F2FE
  participant "AppShell" as shell
  participant "ig-tile-grid" as grid
  participant "ig-layout-bar" as bar
end box
actor -> shell : View dashboard below 1024 px
shell --> actor : Edit layout disabled, explains a wider window is needed (L2-054)
actor -> grid : Narrow the window during edit mode
grid -> grid : collapsed = true; editable = false
grid --> bar : edit mode ends, bar removed (L2-054)
grid --> actor : Flow list, saved layout unchanged, no request (L2-042)
@enduml
