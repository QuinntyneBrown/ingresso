@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Devices
Person(person, "Person")
System_Ext(app, "Published app", "Relying party")
System_Boundary(ingresso, "ingresso") {
  Container(web, "Web app", "Angular", "Settings → Devices card, End session dialog")
  Container(api, "Ingresso.Api", "ASP.NET Core + OpenIddict", "GET/DELETE /api/sessions, /connect/token")
  ContainerDb(db, "Database", "SQL Server / SQLite", "Sessions with a coarse device description")
}
Rel(person, web, "Uses")
Rel(web, api, "JSON over HTTPS, cookie session, anti-forgery header")
Rel(app, api, "OpenID Connect")
Rel(api, db, "EF Core")
@enduml
