@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Connected apps
Person(person, "Person")
System_Ext(app, "Published app", "Relying party")
System_Boundary(ingresso, "ingresso") {
  Container(web, "Web app", "Angular", "Settings → Connected apps card, Revoke access dialog")
  Container(api, "Ingresso.Api", "ASP.NET Core + OpenIddict", "GET/DELETE /api/connected-apps, /connect/token, /connect/userinfo")
  ContainerDb(db, "Database", "SQL Server / SQLite", "OpenIddict authorizations and tokens")
}
Rel(person, web, "Uses")
Rel(web, api, "JSON over HTTPS, cookie session, anti-forgery header")
Rel(app, api, "OpenID Connect")
Rel(api, db, "EF Core")
@enduml
