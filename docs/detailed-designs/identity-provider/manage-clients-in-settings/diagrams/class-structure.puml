@startuml
title Class structure — Manage clients in Settings
hide empty members
enum UserRole {
  Member
  Admin
}
class User {
  Id : Guid
  Email : string
  Role : UserRole
}
User --> UserRole
class GrantAdministratorCommand <<record>> {
  Email : string
}
class RegisterClientCommand <<record>> {
  Name : string?
  RedirectUris : string[]
  PostLogoutRedirectUris : string[]
  Scopes : string[]?
  FrontChannelLogoutUri : string?
  Confidential : bool
}
class RegisteredClientDto <<record>> {
  Client : ClientDto
  ClientSecret : string?
}
class ClientDto <<record>> {
  ClientId : string
  Name : string
  RedirectUris : string[]
  PostLogoutRedirectUris : string[]
  Scopes : string[]
  FrontChannelLogoutUri : string?
  Confidential : bool
  OfflineAccess : bool
  Disabled : bool
}
class NewClient <<record>> {
  ClientSecret : string?
  OfflineAccess : bool
}
class UpdateClientCommand <<record>> {
  ClientId : string
  Name : string?
  RedirectUris : string[]
  OfflineAccess : bool
}
class RotateClientSecretCommand <<record>> {
  ClientId : string
}
class SetClientDisabledCommand <<record>> {
  ClientId : string
  Disabled : bool
}
interface IClientRegistry {
  ListAsync()
  RegisterAsync(NewClient)
  UpdateAsync(clientId, NewClient)
  ReplaceSecretAsync(clientId, secret)
  SetDisabledAsync(clientId, disabled)
  RemoveAsync(clientId)
}
class AdministratorHandler
class ClientsController
RegisterClientCommand ..> RegisteredClientDto : returns
RegisteredClientDto *-- ClientDto
RegisterClientCommand ..> NewClient : builds
IClientRegistry ..> NewClient
ClientsController ..> RegisterClientCommand
ClientsController ..> UpdateClientCommand
ClientsController ..> RotateClientSecretCommand
ClientsController ..> SetClientDisabledCommand
RotateClientSecretCommand ..> RegisteredClientDto : returns
AdministratorHandler ..> User : reads Role
GrantAdministratorCommand ..> User : sets Role
@enduml
