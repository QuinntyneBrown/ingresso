@startuml
title Class structure — Consent
hide empty members
class GetConsentQuery <<record>> {
  UserId : Guid
  ClientId : string
  Scopes : string[]
}
class ConsentDto <<record>> {
  AppName : string
  Email : string
  Ask : ConsentScope[]
  Approved : ConsentScope[]
}
