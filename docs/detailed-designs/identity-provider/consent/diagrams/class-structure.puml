}
class ApproveConsentCommand <<record>> {
  UserId : Guid
  ClientId : string
  Scopes : string[]
}
interface IConsentStore {
  FindAppAsync(clientId)
  ApprovedScopesAsync(userId, clientId)
  FindApprovalAsync(userId, clientId, scopes)
  ApproveAsync(userId, clientId, scopes)
  ApiNamesAsync(scopes)
}
class ConsentApp <<record>> {
  Name : string
  FirstParty : bool
  AllowedScopes : string[]
}
class OpenIddictConsentStore
class ClientDto <<record>> {
  FirstParty : bool
}
GetConsentQuery ..> ConsentDto : returns
ConsentDto o-- ConsentScope
GetConsentQuery ..> IConsentStore
